<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Symf7{% endblock %}</title>
        <style>
            *, *::before, *::after { box-sizing: border-box; }
            body {
                font-family: system-ui, -apple-system, sans-serif;
                margin: 0;
                padding: 0;
                background: #f8f9fa;
                color: #212529;
            }
            header {
                background: #1a1a2e;
                color: #fff;
                padding: 1rem 2rem;
                display: flex;
                align-items: center;
                gap: 1rem;
            }
            header a { color: #e2b96f; text-decoration: none; font-weight: bold; font-size: 1.3rem; }
            main { max-width: 900px; margin: 2rem auto; padding: 0 1.5rem; }
            footer {
                text-align: center;
                color: #6c757d;
                padding: 2rem;
                font-size: 0.875rem;
            }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <header>
            <a href="{{ path('app_home') }}">Symf7</a>
            <span style="opacity:0.6;font-size:0.85rem;">Experimental Symfony 7 App</span>
        </header>
        <main>
            {% block body %}{% endblock %}
        </main>
        <footer>
            Built with <a href="https://symfony.com" style="color:#1a1a2e;">Symfony 7</a>
        </footer>
        {% block javascripts %}{% endblock %}
    </body>
</html>
